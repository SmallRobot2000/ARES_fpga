+#include "RenderConfigs.hpp"
+
+// Exercise the actual constexpr implementation under several configurations.
+// Rename the class so these independent configurations share one test TU.
+#undef _RENDER_CONFIG_HPP_
+#undef RIX_CORE_MAX_DISPLAY_WIDTH
+#undef RIX_CORE_MAX_DISPLAY_HEIGHT
+#define RIX_CORE_MAX_DISPLAY_WIDTH (1u << RIX_CORE_FRAMEBUFFER_SIZE_IN_PIXEL_LG)
+#define RIX_CORE_MAX_DISPLAY_HEIGHT 1
+#define RenderConfig SingleStripConfig
+#include "RenderConfigs.hpp"
+static_assert(rr::SingleStripConfig::getDisplayLines() == 1);
+
+#undef _RENDER_CONFIG_HPP_
+#undef RenderConfig
+#undef RIX_CORE_MAX_DISPLAY_HEIGHT
+#define RIX_CORE_MAX_DISPLAY_HEIGHT 6
+#define RenderConfig SixStripConfig
+#include "RenderConfigs.hpp"
+static_assert(rr::SixStripConfig::getDisplayLines() == 6);
+
+#undef _RENDER_CONFIG_HPP_
+#undef RenderConfig
+#undef RIX_CORE_MAX_DISPLAY_WIDTH
+#define RIX_CORE_MAX_DISPLAY_WIDTH ((1u << RIX_CORE_FRAMEBUFFER_SIZE_IN_PIXEL_LG) + 1)
+#define RenderConfig PartialStripConfig
+#include "RenderConfigs.hpp"
+static_assert(rr::PartialStripConfig::getDisplayLines() == 7);
+
+int main() { return 0; }
